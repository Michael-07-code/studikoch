# Kopiere diese Datei zu ".env.local" und trage dort deine eigenen Werte ein.
# ".env.local" wird nicht mit eingecheckt (siehe .gitignore).

# Erforderlich: Supabase-Projekt für Login + geräteübergreifende
# Speicherung deiner Daten. Siehe supabase/schema.sql für die Einrichtung
# (Project Settings -> API im Supabase-Dashboard für URL + anon key).
# Ohne diese Werte zeigt die App nur einen Einrichtungs-Hinweis an.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: kostenloser API-Key von spoonacular.com/food-api für die
# Budget-Suche (echte Zubereitungszeit + Kosten pro Portion). Ohne diesen
# Key funktioniert die App weiterhin, nur die Budget-Suche bleibt inaktiv.
VITE_SPOONACULAR_API_KEY=
